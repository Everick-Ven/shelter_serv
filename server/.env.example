# ============================================================================
# SHELTER server — пример конфигурации.
#
# Скопируйте в .env и заполните. Файл .env в репозиторий НЕ попадает
# (см. .gitignore). Секреты в коде хранить запрещено (TZ).
# ============================================================================

# --- среда -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080
# Публичный HTTPS-адрес сервиса. В production обязателен и только https://
PUBLIC_BASE_URL=https://shelter.example.com
# Разрешённые Origin (через запятую) — для CORS и валидации редиректов
ALLOWED_ORIGINS=https://shelter.example.com

# TLS терминирует обратный прокси. Включите, если прокси доверенный и
# корректно передаёт X-Forwarded-Proto / X-Forwarded-For.
TRUST_PROXY=true
REQUIRE_HTTPS=true
HSTS_MAX_AGE=31536000

# --- база данных -----------------------------------------------------------
DATABASE_URL=postgres://shelter:shelter@localhost:5432/shelter
PG_POOL_MAX=10
PG_SSL=false
# Применять миграции при старте контейнера (docker compose up с нуля)
RUN_MIGRATIONS_ON_BOOT=true

# --- сессии ----------------------------------------------------------------
# Минимум 32 символа. Генерация:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32+-char-random-string
COOKIE_NAME=shelter_session
COOKIE_SECURE=true
# COOKIE_DOMAIN=.shelter.example.com
SESSION_TTL_SECONDS=2592000
SESSION_RENEW_AFTER_SECONDS=604800

# --- OAuth: Google ---------------------------------------------------------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shelter.example.com/api/v1/auth/google/callback

# --- OAuth: Yandex ID ------------------------------------------------------
YANDEX_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://shelter.example.com/api/v1/auth/yandex/callback

# --- dev-вход (только локально; в production принудительно выключен) -------
# Даёт аккаунт, но НЕ даёт подписку: entitlement проверяется отдельно.
DEV_LOGIN_ENABLED=true

# --- платежи ---------------------------------------------------------------
# yookassa | mock   (mock запрещён в production)
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CAPTURE=true
# Ключ проверки подписи уведомлений. Обязателен всегда.
# Генерация:  openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=change-me-webhook-signing-key
PAYMENT_SUCCESS_URL=https://shelter.example.com/checkout/success
PAYMENT_CANCEL_URL=https://shelter.example.com/pricing
PAYMENT_IDEMPOTENCY_TTL_SECONDS=604800
ORDER_TTL_SECONDS=1800

# --- канал обновлений (GitHub Releases) ------------------------------------
UPDATES_ENABLED=true
GITHUB_REPO=Everick-Ven/shelter
# Необязательно: повышает лимиты GitHub API. В код не коммитим.
GITHUB_TOKEN=
# Необязательно: путь к дополнительному CA-сертификату. Нужен, если исходящий
# трафик идёт через корпоративный прокси с подменой TLS-сертификата —
# без него Node отвечает "unable to verify the first certificate".
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
UPDATES_CHANNEL=stable
UPDATES_CACHE_TTL_SECONDS=300
# Принудительное обновление: версии ниже этой помечаются forceUpdate
UPDATES_MIN_CLIENT_VERSION=

# --- rate limit ------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=10 minutes
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW=10 minutes
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_WINDOW=1 minute

# --- администраторы --------------------------------------------------------
# Email'ы, которым при первом входе выдаётся роль admin (панель /manage)
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# ---- Вход в панель /manage: логин + пароль (не зависит от OAuth) ----
# Аккаунт создаётся сервером при старте; пароль из env авторитетен при старте
# (ротация: поменять значение и перезапустить контейнер).
ADMIN_EMAIL=admin@shelter.local
# Вне production без этой переменной действует ДЕМО-пароль shelter-demo-admin
# (подсказка показывается на экране входа). В production переменная обязательна
# (>= 12 символов, не демо-значение) — иначе сервер не стартует.
# ADMIN_PASSWORD=

SUPPORT_EMAIL=support@shelter.example.com

# --- статика ---------------------------------------------------------------
# Каталог с витриной (домен/) и панелью (домен/manage)
PUBLIC_DIR=public
